 "cues": {
  "treadmill": [
   "Straddle the belt, clip the safety key to your clothing, then start at walking speed.",
   "Stand tall near the front, look ahead, and hold the rails only for balance.",
   "Raise speed or incline gradually. Pull the key or press stop to end."
  ],
  "bike": [
   "Set the saddle so your knee stays slightly bent at the bottom of the pedal stroke.",
   "Strap your feet in and keep your knees tracking over your toes.",
   "Raise resistance, not only cadence, to make it harder."
  ],
  "elliptical": [
   "Step on while holding the fixed handles; keep your feet flat on the pedals.",
   "Stand upright and push through your whole foot, heels down.",
   "Use the moving handles to add your arms. Pedal backward to shift work toward hamstrings and glutes."
  ],
  "stairmaster": [
   "Start slow and step onto the whole stair, not just your toes.",
   "Stand tall with light hands on the rails; don't lean on them.",
   "Pick a speed you can hold without hanging on, then add time."
  ],
  "arm_bike": [
   "Set the seat so the crank sits level with your shoulders.",
   "Sit tall, brace your core, and turn the handles in smooth circles.",
   "Alternate forward and backward intervals."
  ],
  "rower": [
   "Strap the feet across the widest part of your shoe. A damper of 3–5 suits most people.",
   "Drive in order: legs, then lean back slightly, then pull the handle to your lower ribs.",
   "Return in reverse: arms, body, then knees. Your legs make most of the power."
  ],
  "multi_rig": [
   "Pick the bar height for the move: pull-ups, hanging knee raises or band work.",
   "For pull-ups, start from a dead hang, pull your chest toward the bar and lower under control.",
   "Clear plates and bands when you finish."
  ],
  "tires": [
   "Squat down with your chest against the tire and fingers under the tread.",
   "Drive with legs and hips first, then push the tire over.",
   "Med-ball slams: lift the ball overhead, slam it in front of you, squat to pick it up."
  ],
  "chin_dip_assist": [
   "Pick the assist weight. More weight means more help.",
   "Dips: kneel on the pad, grip the handles and lower until your elbows bend about 90°.",
   "Chin-ups: pull your chin over the bar, then lower slowly to a full hang."
  ],
  "shoulder_press_machine": [
   "Set the seat so the handles start at about shoulder height.",
   "Keep your back flat on the pad and press up without slamming into lockout.",
   "Lower slowly back to shoulder height."
  ],
  "lat_pulldown": [
   "Lock your thighs under the pad and grip a little wider than your shoulders.",
   "Lean back slightly and pull the bar to your upper chest, elbows driving down.",
   "Let the bar rise slowly until your arms are straight."
  ],
  "low_row": [
   "Set the chest pad so you reach the handles with straight arms.",
   "Keep your chest on the pad and pull the handles toward your torso.",
   "Squeeze your shoulder blades together, then return slowly."
  ],
  "chest_press_machine": [
   "Set the seat so the handles line up with mid-chest.",
   "Keep your shoulder blades back on the pad and press until your arms are nearly straight.",
   "Return slowly until you feel a stretch across your chest."
  ],
  "leg_press": [
   "Sit all the way back, feet shoulder-width in the middle of the platform.",
   "Release the safeties and lower until your knees reach about 90°, lower back on the pad.",
   "Press through your heels without locking your knees, then re-engage the safeties."
  ],
  "leg_extension": [
   "Line your knee up with the machine's pivot and set the pad on your lower shin.",
   "Straighten your legs and pause briefly at the top.",
   "Lower under control; don't let the stack slam."
  ],
  "seated_leg_curl": [
   "Line your knee up with the pivot; heel pad just above the heel, thigh pad snug.",
   "Curl your heels down and back as far as you can.",
   "Return slowly to straight legs."
  ],
  "pec_fly_rear_delt": [
   "Pec fly: sit facing out, handles at chest height, bring them together in a wide hug.",
   "Rear delt: face the pad, take the handles and open your arms back with a slight elbow bend.",
   "Set the arm position for the mode you're using before you load it."
  ],
  "prone_leg_curl": [
   "Lie face down with your knees just past the bench edge and the pad above your heels.",
   "Keep your hips down and curl your heels toward your glutes.",
   "Lower slowly to nearly straight."
  ],
  "cable_pulley": [
   "Set the pulley height for the move: high for pushdowns, low for curls, chest height for flys.",
   "Clip on the attachment you need and start light.",
   "Brace and move through a smooth full range; don't let the stack slam."
  ],
  "long_pull": [
   "Pulldown side: thighs under the pad, pull the bar to your upper chest.",
   "Long-pull side: feet on the plate, knees soft, back straight; pull the handle to your stomach.",
   "Return slowly on both sides so the weights don't crash.",
   "Single cables (2 on this station): clip on a rope, bar or handle for pushdowns, curls or face pulls, and set the pulley height first."
  ],
  "iso_row": [
   "Set the seat so the handles sit at chest height, chest on the pad.",
   "Pull with one or both arms, driving your elbows back.",
   "Each arm moves on its own, so control both sides through the full range."
  ],
  "preacher_curl_machine": [
   "Set the seat so your armpits sit at the top of the pad.",
   "Keep the backs of your arms on the pad and curl the handles up.",
   "Lower until your arms are almost straight."
  ],
  "seated_curl_machine": [
   "Line your elbows up with the machine's pivot.",
   "Curl up without lifting your elbows off the pad.",
   "Lower slowly to full extension."
  ],
  "seated_calf": [
   "Balls of your feet on the platform, pad snug over your lower thighs.",
   "Release the safety and drop your heels for a full stretch.",
   "Rise as high as you can on your toes and pause."
  ],
  "iso_decline": [
   "Set the seat so the handles line up with your lower chest.",
   "Press out and slightly down until your arms are nearly straight.",
   "Lower under control. Each arm moves on its own."
  ],
  "iso_shoulder": [
   "Set the seat so the handles start at shoulder height.",
   "Keep your back flat on the pad and press overhead.",
   "Lower slowly. Load plates evenly on both arms."
  ],
  "iso_high_row": [
   "Set the seat so you reach the handles with arms fully extended.",
   "Pull down and back toward your chest, elbows driving down.",
   "Return slowly with your chest against the pad."
  ],
  "linear_leg_press": [
   "Sit back, feet shoulder-width on the platform.",
   "Lower until your knees reach about 90° without your hips lifting off the pad.",
   "Press through your heels, keeping a soft knee at the top."
  ],
  "hack_squat": [
   "Shoulders under the pads, back flat, feet shoulder-width and slightly forward.",
   "Release the safeties and squat until your thighs are about parallel.",
   "Drive up through your whole foot, then re-engage the safeties."
  ],
  "ghr": [
   "Set the foot plate so your knees sit just behind the pad.",
   "Lower your upper body forward with hips straight, then pull back up with your hamstrings.",
   "Push off with your hands on the way up if you need help."
  ],
  "bench_press": [
   "Lie with your eyes under the bar, feet flat, shoulder blades pulled back.",
   "Unrack, lower the bar to mid-chest, then press it back up over your shoulders.",
   "Use a spotter or set the safeties for heavy sets."
  ],
  "power_rack": [
   "Set the J-hooks at upper-chest height and the safeties just below your lowest squat point.",
   "Bar on your upper back, feet shoulder-width; brace and squat to at least parallel.",
   "Stand up through your whole foot, then walk the bar forward into the hooks."
  ],
  "dip_station": [
   "Grip the bars and push up to straight arms, shoulders down.",
   "Lower until your elbows bend about 90°. Lean forward a little to use more chest.",
   "Press back up to straight arms."
  ],
  "roman_chair": [
   "Set the pad just below your hip crease with heels under the rollers.",
   "Lower your upper body with a flat back.",
   "Rise until your body forms a straight line; don't arch past it."
  ],
  "dumbbells": [
   "Pick a weight you can move with good form for every rep.",
   "Lift dumbbells off the rack with a flat back and no twisting.",
   "Put each pair back in its labeled spot."
  ],
  "turf_sled": [
   "Load the sled light to start.",
   "Lean in with arms extended and drive with short, powerful steps.",
   "Keep your back flat and push through the balls of your feet."
  ],
  "hip_adductor": [
   "Set the pads for a comfortable starting width.",
   "Inner thigh: squeeze your legs together. Outer thigh: switch the pads and push out.",
   "Return slowly; don't let the weight pull you open."
  ],
  "hip_thrust_machine": [
   "Sit with your upper back on the pad and the hip pad across your hips.",
   "Feet flat, placed so your shins are vertical at the top.",
   "Drive your hips up, squeeze your glutes, then lower under control."
  ],
  "trx": [
   "Adjust the strap length for the exercise, then lean so the straps stay taut.",
   "Hold your body in a straight plank line the whole time.",
   "Make it harder or easier by moving your feet closer to or farther from the anchor."
  ],
  "long_pull1": [
   "Pulldown side: thighs under the pad, pull the bar to your upper chest.",
   "Long-pull side: feet on the plate, knees soft, back straight; pull the handle to your stomach.",
   "Return slowly on both sides so the weights don't crash.",
   "Single cable (1 on this station): clip on a rope, bar or handle for pushdowns, curls or face pulls, and set the pulley height first."
  ],
  "combo_assist": [
   "Pulldown side: thighs under the pad, pull the bar to your upper chest.",
   "Long-pull side: feet on the plate, knees soft, back straight; pull the handle to your stomach.",
   "Return slowly on both sides so the weights don't crash.",
   "Cables (2 on this station): clip on a rope, bar or handle and set the pulley height first.",
   "Dip/chin assist: more weight means more help. Kneel on the pad, then dip to about 90° or pull your chin over the bar."
  ],
  "flat_bench": [
   "Set the back pad: flat for presses and rows, 30–45° for incline work, upright for seated shoulder presses.",
   "Make sure the pin locks fully before you sit or lie down.",
   "Feet flat, shoulder blades back. Wipe it down and leave it flat for the next person."
  ],
  "curved_treadmill": [
   "Step on while holding the rails. There's no motor: the belt only moves when you do.",
   "Walk or run near the middle of the curve. Move forward up the curve to speed up, drift back to slow down.",
   "To stop, ease off, step back onto the flat rear section and hold the rails."
  ]
 },
